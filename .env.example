# Public hostname only, without a scheme. For local Docker smoke tests use http://localhost.
DOMAIN=do-over.example.com
# Canonical public origin, including https:// and no trailing slash.
SITE_URL=https://do-over.example.com
# Compose's private Redis service. No Redis port is published on the host.
REDIS_URL=redis://redis:6379
# Provider credentials; leave empty for rules-only mode. Never use a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
# Choose a structured-output model after the A2 provider comparison; no model id is assumed.
OPENAI_MODEL=
# Optional model-supported reasoning level: none, low, medium, high, xhigh, max.
# gpt-6-luna supports none for low-latency tagging; leave blank to use the model default.
OPENAI_REASONING_EFFORT=
# Optional fallback provider credential.
ANTHROPIC_API_KEY=
# Anthropic structured-output model selected during A2.
ANTHROPIC_MODEL=
# Provider attempted first: openai or anthropic.
LLM_PRIMARY=openai
# Daily model-call budget; exceeding it uses rules-only tagging.
MODEL_DAILY_CALL_CAP=20000
# Optional speech-to-text model; needed only if voice is approved and implemented.
OPENAI_TRANSCRIBE_MODEL=
# Optional text-to-speech model; needed only if voice is approved and implemented.
OPENAI_TTS_MODEL=
# Baked into the browser bundle. Changing this requires a rebuild (deploy.sh does this).
NEXT_PUBLIC_PRO_PREVIEW=true
# Set a long random value to protect /api/admin/stats. Do not reuse an API key.
ADMIN_KEY=
# Replaced by deploy.sh with the checked-out full commit SHA. Do not maintain manually.
GIT_SHA=local
